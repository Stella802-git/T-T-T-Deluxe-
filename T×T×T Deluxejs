// Get the canvas and drawing context
const canvas = document.getElementById("boardCanvas");
const ctx = canvas.getContext("2d");

// Get the game display elements
const statusDisplay = document.getElementById("status");

const scoreXDisplay = document.getElementById("scoreX");
const scoreODisplay = document.getElementById("scoreO");
const scoreDrawDisplay = document.getElementById("scoreDraw");

// Get the buttons
const newGameButton = document.getElementById("newGame");
const resetScoresButton = document.getElementById("resetScores");


// GAME VARIABLES

let board = ["", "", "", "", "", "", "", "", ""];

let currentPlayer = "X";

let gameOver = false;

let winningCombination = null;


// SCOREBOARD

let scores = {
    X: 0,
    O: 0,
    draws: 0
};


// ALL POSSIBLE WINNING COMBINATIONS

const winningPatterns = [

    [0, 1, 2],
    [3, 4, 5],
    [6, 7, 8],

    [0, 3, 6],
    [1, 4, 7],
    [2, 5, 8],

    [0, 4, 8],
    [2, 4, 6]

];


// DRAW THE BOARD

function drawBoard() {

    ctx.clearRect(0, 0, 300, 300);

    // Draw the grid
    ctx.beginPath();

    ctx.strokeStyle = "#38bdf8";
    ctx.lineWidth = 3;

    ctx.moveTo(100, 0);
    ctx.lineTo(100, 300);

    ctx.moveTo(200, 0);
    ctx.lineTo(200, 300);

    ctx.moveTo(0, 100);
    ctx.lineTo(300, 100);

    ctx.moveTo(0, 200);
    ctx.lineTo(300, 200);

    ctx.stroke();


    // Draw X and O
    for (let i = 0; i < board.length; i++) {

        const column = i % 3;
        const row = Math.floor(i / 3);

        const centerX = column * 100 + 50;
        const centerY = row * 100 + 50;

        if (board[i] === "X") {

            drawX(centerX, centerY);

        } else if (board[i] === "O") {

            drawO(centerX, centerY);

        }

    }


    // Highlight the winning line
    if (winningCombination !== null) {

        drawWinningLine();

    }

}


// DRAW X

function drawX(x, y) {

    ctx.beginPath();

    ctx.strokeStyle = "#38bdf8";
    ctx.lineWidth = 7;
    ctx.lineCap = "round";

    ctx.moveTo(x - 25, y - 25);
    ctx.lineTo(x + 25, y + 25);

    ctx.moveTo(x + 25, y - 25);
    ctx.lineTo(x - 25, y + 25);

    ctx.stroke();

}

// DRAW O

function drawO(x, y) {

    ctx.beginPath();

    ctx.strokeStyle = "#c084fc";
    ctx.lineWidth = 7;

    ctx.arc(x, y, 28, 0, Math.PI * 2);

    ctx.stroke();

}


// HIGHLIGHT THE WINNING LINE

function drawWinningLine() {

    const first = winningCombination[0];
    const last = winningCombination[2];

    const startX = (first % 3) * 100 + 50;
    const startY = Math.floor(first / 3) * 100 + 50;

    const endX = (last % 3) * 100 + 50;
    const endY = Math.floor(last / 3) * 100 + 50;

    ctx.beginPath();

    ctx.strokeStyle = "#ff8080";
    ctx.lineWidth = 9;
    ctx.lineCap = "round";

    ctx.moveTo(startX, startY);
    ctx.lineTo(endX, endY);

    ctx.stroke();

}


// HANDLE CANVAS CLICKS

canvas.addEventListener("click", function(event) {

    // Stop if the game has finished
    if (gameOver) {
        return;
    }

    // Get the click coordinates
    const rect = canvas.getBoundingClientRect();

    const mouseX = (event.clientX - rect.left) * 300 / rect.width;
    const mouseY = (event.clientY - rect.top) * 300 / rect.height;

    // Identify the clicked row and column
    const column = Math.floor(mouseX / 100);
    const row = Math.floor(mouseY / 100);

    // Convert them into an array index
    const index = row * 3 + column;

    // Stop if the square is already occupied
    if (board[index] !== "") {
        return;
    }

    // Place the current player's mark
    board[index] = currentPlayer;

    // Redraw the board
    drawBoard();

    // Check whether someone won
    checkWinner();

});


// CHECK FOR A WINNER

function checkWinner() {

    for (const pattern of winningPatterns) {

        const [a, b, c] = pattern;

        if (
            board[a] !== "" &&
            board[a] === board[b] &&
            board[b] === board[c]
        ) {

            gameOver = true;

            winningCombination = pattern;

            scores[currentPlayer]++;

            updateScores();

            drawBoard();

            statusDisplay.textContent =
                currentPlayer + " wins! Congratulations!";

            return;

        }

    }


    // Check for a draw
    if (!board.includes("")) {

        gameOver = true;

        scores.draws++;

        updateScores();

        statusDisplay.textContent = "It's a draw!";

        return;

    }


    // Switch players
    currentPlayer = currentPlayer === "X" ? "O" : "X";

    statusDisplay.textContent = currentPlayer + "'s turn";

}


// UPDATE THE SCOREBOARD

function updateScores() {

    scoreXDisplay.textContent = scores.X;

    scoreODisplay.textContent = scores.O;

    scoreDrawDisplay.textContent = scores.draws;

}


// START A NEW GAME

function newGame() {

    board = ["", "", "", "", "", "", "", "", ""];

    currentPlayer = "X";

    gameOver = false;

    winningCombination = null;

    statusDisplay.textContent = "X's turn";

    drawBoard();

}


// RESET ALL SCORES

function resetScores() {

    scores = {
        X: 0,
        O: 0,
        draws: 0
    };

    updateScores();

    newGame();

}


// BUTTON EVENTS

newGameButton.addEventListener("click", newGame);

resetScoresButton.addEventListener("click", resetScores);


// START THE GAME

drawBoard();

updateScores();